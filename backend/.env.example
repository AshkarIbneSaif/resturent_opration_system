# --- Database ---
# Prototype (this sandbox): SQLite file.
# Production: replace with a PostgreSQL connection string AND change
# `provider` in prisma/schema.prisma from "sqlite" to "postgresql".
DATABASE_URL="file:./dev.db"

# --- App ---
APP_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=4000

# --- Auth ---
# Generate a real random 32+ byte secret for production. Never commit the real value.
AUTH_SECRET=dev-only-change-me-before-any-real-deployment
AUTH_TOKEN_TTL_HOURS=12

# Extra password required to confirm CRITICAL actions (restaurant identity,
# owner account changes, backup restore, historical financial corrections).
# Separate from login password. Change before production use.
CRITICAL_ACTION_PASSPHRASE=dev-only-critical-confirm

# --- Currency (deployment-fixed — NOT user/UI configurable, see REQUIREMENTS.md FR-090..092) ---
CURRENCY_CODE=BDT
CURRENCY_SYMBOL=৳
DECIMAL_PLACES=2

# --- Restaurant ---
RESTAURANT_TIMEZONE=Asia/Dhaka
